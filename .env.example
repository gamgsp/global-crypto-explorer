# Global Crypto Explorer - Environment Configuration

# Server Network Settings
PORT=3001
HOST=0.0.0.0

# Public Domain (optional - e.g. https://explorer.mycoin.org)
# If left empty, explorer will automatically detect domain from incoming requests, falling back to http://localhost:PORT
DOMAIN=

# Daemon RPC Node Credentials (can also be configured & updated in Admin Panel)
RPC_HOST=127.0.0.1
RPC_PORT=9998
RPC_USER=rpcuser
RPC_PASSWORD=rpcpassword
RPC_TIMEOUT=5000
