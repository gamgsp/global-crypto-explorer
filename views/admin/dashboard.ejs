<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Control Panel - <%= coin.name || appName %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background-color: #0b0f19;
      font-family: 'Outfit', sans-serif;
      min-height: 100vh;
      color: #fff;
    }
    .admin-layout {
      display: flex;
      min-height: 100vh;
    }
    /* Left Sidebar */
    .admin-sidebar {
      width: 270px;
      min-width: 270px;
      background: rgba(15, 23, 42, 0.95);
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      height: 100vh;
      z-index: 50;
      backdrop-filter: blur(16px);
    }
    .sidebar-header {
      padding: 1.5rem 1.25rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .sidebar-logo-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: linear-gradient(135deg, #10b981, #3b82f6);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
    }
    .sidebar-nav {
      flex: 1;
      padding: 1.25rem 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      overflow-y: auto;
    }
    .sidebar-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
      border-radius: 10px;
      color: #94a3b8;
      text-decoration: none;
      font-size: 0.92rem;
      font-weight: 600;
      transition: all 0.2s;
    }
    .sidebar-item i {
      width: 20px;
      font-size: 1.05rem;
      text-align: center;
    }
    .sidebar-item:hover {
      color: #fff;
      background: rgba(255, 255, 255, 0.05);
      transform: translateX(3px);
    }
    .sidebar-item.active {
      color: #fff;
      background: #10b981;
      box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
      transform: none;
    }
    .sidebar-footer {
      padding: 1.25rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    /* Main Content Area */
    .admin-main {
      flex: 1;
      padding: 2rem 2.5rem;
      overflow-y: auto;
      max-width: calc(100vw - 270px);
    }
    .main-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .admin-card {
      background: rgba(17, 24, 39, 0.75);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 2.25rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      margin-bottom: 2rem;
    }
    .form-group {
      margin-bottom: 1.35rem;
    }
    .form-group label {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      color: #94a3b8;
      margin-bottom: 0.45rem;
    }
    .form-control {
      width: 100%;
      background: rgba(15, 23, 42, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px;
      padding: 0.75rem 0.95rem;
      color: #fff;
      font-size: 0.95rem;
    }
    .form-control:focus {
      outline: none;
      border-color: #10b981;
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
    }
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.35rem;
    }
    .form-row-3 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1.35rem;
    }
    .btn-save {
      background: #10b981;
      color: #fff;
      border: none;
      padding: 0.8rem 1.6rem;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.2s;
    }
    .btn-save:hover {
      background: #059669;
      transform: translateY(-1px);
    }
    .alert-success {
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid #10b981;
      color: #6ee7b7;
      padding: 0.85rem 1.25rem;
      border-radius: 10px;
      margin-bottom: 1.5rem;
      font-size: 0.9rem;
    }
    .alert-danger {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid #ef4444;
      color: #fca5a5;
      padding: 0.85rem 1.25rem;
      border-radius: 10px;
      margin-bottom: 1.5rem;
      font-size: 0.9rem;
    }
    .dynamic-item-row {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      margin-bottom: 0.75rem;
      background: rgba(15, 23, 42, 0.5);
      padding: 0.65rem 0.85rem;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .btn-remove {
      background: rgba(239, 68, 68, 0.2);
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: #f87171;
      width: 36px;
      height: 36px;
      border-radius: 8px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }
    .btn-remove:hover {
      background: #ef4444;
      color: #fff;
    }
    .btn-add {
      background: rgba(255, 255, 255, 0.08);
      border: 1px dashed rgba(255, 255, 255, 0.2);
      color: #cbd5e1;
      padding: 0.65rem 1.25rem;
      border-radius: 10px;
      cursor: pointer;
      font-size: 0.85rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.5rem;
    }
    .btn-add:hover {
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
    }
    @media (max-width: 900px) {
      .admin-layout {
        flex-direction: column;
      }
      .admin-sidebar {
        width: 100%;
        height: auto;
        position: relative;
      }
      .admin-main {
        max-width: 100%;
        padding: 1.5rem;
      }
      .form-row, .form-row-3 {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="admin-layout">
    <!-- LEFT SIDEBAR -->
    <aside class="admin-sidebar">
      <div class="sidebar-header" style="display: flex; flex-direction: column; align-items: flex-start; gap: 0.55rem; padding: 1.25rem 1.25rem 1.1rem;">
        <% if (coin.logo && coin.logo.trim()) { %>
          <div style="width: 100%; display: flex; align-items: center; justify-content: flex-start; min-height: 44px;">
            <img src="<%= coin.logo %>" alt="<%= coin.name %>" style="max-height: 52px; max-width: 220px; width: auto; height: auto; object-fit: contain; border-radius: 8px; display: block;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
            <div style="display: none; width: 42px; height: 42px; border-radius: 10px; background: linear-gradient(135deg, #10b981, #3b82f6); align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);">
              <i class="fa-solid fa-gear" style="color: #fff; font-size: 1.25rem;"></i>
            </div>
          </div>
        <% } else { %>
          <div class="sidebar-logo-icon" style="width: 42px; height: 42px; border-radius: 10px; background: linear-gradient(135deg, #10b981, #3b82f6); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);">
            <i class="fa-solid fa-gear" style="color: #fff; font-size: 1.25rem;"></i>
          </div>
        <% } %>
        <div style="width: 100%; display: flex; align-items: center; gap: 0.4rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 0.1rem;">
          <span style="font-weight: 700; font-size: 0.82rem; color: #fff; letter-spacing: -0.01em;">Admin Portal</span>
          <span style="color: #64748b; font-size: 0.8rem;">-</span>
          <span style="font-size: 0.82rem; font-weight: 600; color: #10b981; overflow: hidden; text-overflow: ellipsis;"><%= coin.name %></span>
        </div>
      </div>

      <!-- Navigation Menu -->
      <nav class="sidebar-nav">
        <a href="/<%= adminSlug %>?tab=general" class="sidebar-item <%= (!tab || tab === 'general') ? 'active' : '' %>">
          <i class="fa-solid fa-coins"></i> <span>Coin & Node</span>
        </a>
        <a href="/<%= adminSlug %>?tab=hero" class="sidebar-item <%= tab === 'hero' ? 'active' : '' %>">
          <i class="fa-solid fa-bullhorn"></i> <span>Hero Banner</span>
        </a>
        <a href="/<%= adminSlug %>?tab=masternodes" class="sidebar-item <%= tab === 'masternodes' ? 'active' : '' %>">
          <i class="fa-solid fa-share-nodes"></i> <span>Masternodes</span>
        </a>
        <a href="/<%= adminSlug %>?tab=theme" class="sidebar-item <%= tab === 'theme' ? 'active' : '' %>">
          <i class="fa-solid fa-palette"></i> <span>Theme & Colors</span>
        </a>
        <a href="/<%= adminSlug %>?tab=socials" class="sidebar-item <%= tab === 'socials' ? 'active' : '' %>">
          <i class="fa-solid fa-share-from-square"></i> <span>Social Links</span>
        </a>
        <a href="/<%= adminSlug %>?tab=exchanges" class="sidebar-item <%= tab === 'exchanges' ? 'active' : '' %>">
          <i class="fa-solid fa-building-columns"></i> <span>Markets / Exchanges</span>
        </a>
        <a href="/<%= adminSlug %>?tab=footer" class="sidebar-item <%= tab === 'footer' ? 'active' : '' %>">
          <i class="fa-solid fa-bars-staggered"></i> <span>Footer Content</span>
        </a>
        <a href="/<%= adminSlug %>?tab=profile" class="sidebar-item <%= tab === 'profile' ? 'active' : '' %>">
          <i class="fa-solid fa-user-gear"></i> <span>Admin Profile</span>
        </a>
        <a href="/<%= adminSlug %>?tab=updates" class="sidebar-item <%= tab === 'updates' ? 'active' : '' %>" style="display: flex; align-items: center; justify-content: space-between;">
          <span style="display: inline-flex; align-items: center; gap: 0.65rem;"><i class="fa-solid fa-cloud-arrow-down" style="color: #38bdf8;"></i> <span>System & Updates</span></span>
          <% if (updateInfo && updateInfo.updateAvailable) { %>
            <span class="badge badge-warning" style="font-size: 0.65rem; padding: 2px 7px; font-weight: 700; border-radius: 9999px;">UPDATE</span>
          <% } %>
        </a>
      </nav>

      <!-- Sidebar Footer -->
      <div class="sidebar-footer">
        <a href="/" target="_blank" class="btn btn-outline" style="width: 100%; justify-content: center; padding: 0.55rem; font-size: 0.85rem; text-decoration: none;">
          <i class="fa-solid fa-arrow-up-right-from-square"></i> View Explorer
        </a>
        <a href="/<%= adminSlug %>/logout" class="btn btn-danger" style="width: 100%; justify-content: center; padding: 0.55rem; font-size: 0.85rem; text-decoration: none;">
          <i class="fa-solid fa-right-from-bracket"></i> Logout
        </a>
      </div>
    </aside>

    <!-- RIGHT MAIN CONTENT -->
    <main class="admin-main">
      <div class="main-topbar">
        <div>
          <div style="font-size: 0.8rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Control Dashboard</div>
          <h1 style="font-size: 1.5rem; font-weight: 800; color: #fff;">
            <% if (!tab || tab === 'general') { %>Coin & Daemon Settings<% } %>
            <% if (tab === 'hero') { %>Hero Banner Customizer<% } %>
            <% if (tab === 'masternodes') { %>Masternodes Feature Configuration<% } %>
            <% if (tab === 'theme') { %>Theme & Appearance Customizer<% } %>
            <% if (tab === 'socials') { %>Social Profiles & Price Trackers<% } %>
            <% if (tab === 'exchanges') { %>Listed Exchanges & Trading Pairs<% } %>
            <% if (tab === 'footer') { %>Footer Content & Clickable Links<% } %>
            <% if (tab === 'profile') { %>Administrator Profile & Security<% } %>
            <% if (tab === 'updates') { %>System Updates & GitHub Sync<% } %>
          </h1>
        </div>

        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <span class="badge badge-success"><span class="pulse-dot"></span> Admin Active</span>
        </div>
      </div>

            <!-- Global Update Available Banner -->
      <% if (updateInfo && updateInfo.updateAvailable && tab !== 'updates') { %>
        <div style="background: linear-gradient(135deg, rgba(14, 165, 233, 0.15), rgba(99, 102, 241, 0.15)); border: 1px solid rgba(56, 189, 248, 0.4); border-radius: 14px; padding: 1.1rem 1.4rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; box-shadow: 0 4px 20px rgba(14, 165, 233, 0.15);">
          <div style="display: flex; align-items: center; gap: 1rem;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(56, 189, 248, 0.2); display: flex; align-items: center; justify-content: center; color: #38bdf8; font-size: 1.3rem;">
              <i class="fa-solid fa-gift"></i>
            </div>
            <div>
              <div style="font-weight: 700; color: #fff; font-size: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                New Update Available on GitHub!
                <span class="badge badge-cyan" style="font-size: 0.7rem;"><%= updateInfo.remote.shortSha %></span>
              </div>
              <div style="font-size: 0.85rem; color: #94a3b8; margin-top: 2px;">
                <%= updateInfo.remote.msg %> &bull; <span style="color: #cbd5e1;"><%= updateInfo.remote.author %></span>
              </div>
            </div>
          </div>
          <a href="/<%= adminSlug %>?tab=updates" class="btn btn-sm btn-primary" style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1.1rem; font-weight: 600; text-decoration: none; border-radius: 8px;">
            <i class="fa-solid fa-cloud-arrow-down"></i> View & Install Update
          </a>
        </div>
      <% } %>

      <% if (message) { %>
        <div class="alert-success"><i class="fa-solid fa-circle-check"></i> <%= message %></div>
      <% } %>
      <% if (error) { %>
        <div class="alert-danger"><i class="fa-solid fa-triangle-exclamation"></i> <%= error %></div>
      <% } %>

      <!-- TAB 1: COIN & NODE SETTINGS -->
      <% if (!tab || tab === 'general') { %>
        <div class="admin-card">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-coins" style="color: #10b981;"></i> Coin Identity & Daemon Node Settings
          </h2>
          <form action="/<%= adminSlug %>/update-coin" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label>Coin Name</label>
                <input type="text" name="coin_name" class="form-control" value="<%= coin.name %>" required>
              </div>
              <div class="form-group">
                <label>Ticker / Symbol</label>
                <input type="text" name="coin_symbol" class="form-control" value="<%= coin.symbol %>" required>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>Decimals</label>
                <input type="number" name="coin_decimals" class="form-control" value="<%= coin.decimals %>" required>
              </div>
              <div class="form-group">
                <label>Default Chart Timeline</label>
                <select name="chart_default_days" class="form-control">
                  <option value="7" <%= (settings.chart && settings.chart.defaultDays == 7) ? 'selected' : '' %>>Last 7 Days</option>
                  <option value="10" <%= (settings.chart && settings.chart.defaultDays == 10) ? 'selected' : '' %>>Last 10 Days</option>
                  <option value="15" <%= (!settings.chart || !settings.chart.defaultDays || settings.chart.defaultDays == 15) ? 'selected' : '' %>>Last 15 Days</option>
                  <option value="30" <%= (settings.chart && settings.chart.defaultDays == 30) ? 'selected' : '' %>>Last 30 Days (Recommended)</option>
                </select>
              </div>
              <div class="form-group">
                <label>Official Website URL</label>
                <input type="text" name="official_website" class="form-control" value="<%= coin.officialWebsite %>" placeholder="https://mycoin.org">
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>Coin Logo URL</label>
                <input type="text" name="logo_url" class="form-control" value="<%= coin.logo %>" placeholder="https://example.com/logo.png">
              </div>
              <div class="form-group">
                <label>Favicon URL</label>
                <input type="text" name="favicon_url" class="form-control" value="<%= coin.favicon %>" placeholder="https://example.com/favicon.ico">
              </div>
            </div>

            <hr style="border-color: rgba(255, 255, 255, 0.08); margin: 1.5rem 0;">
            <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 1rem; color: #38bdf8;">
              <i class="fa-solid fa-server"></i> Daemon RPC Connection
            </h3>

            <div class="form-row">
              <div class="form-group">
                <label>RPC Host</label>
                <input type="text" name="rpc_host" class="form-control" value="<%= settings.rpc.host %>" required>
              </div>
              <div class="form-group">
                <label>RPC Port</label>
                <input type="number" name="rpc_port" class="form-control" value="<%= settings.rpc.port %>" required>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>RPC Username</label>
                <input type="text" name="rpc_user" class="form-control" value="<%= settings.rpc.user %>" required>
              </div>
              <div class="form-group">
                <label>RPC Password</label>
                <input type="password" name="rpc_password" class="form-control" value="<%= settings.rpc.password %>" required>
              </div>
            </div>

            <button type="submit" class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Save Coin & RPC Settings</button>
          </form>
        </div>
      <% } %>

      <!-- TAB 2: HERO BANNER CUSTOMIZER -->
      <% if (tab === 'hero') { %>
        <div class="admin-card">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-bullhorn" style="color: #38bdf8;"></i> Homepage Hero Banner Customizer
          </h2>
          <form action="/<%= adminSlug %>/update-hero" method="POST">
            <div class="form-group">
              <label>Display Hero Banner on Dashboard?</label>
              <select name="has_hero_banner" class="form-control">
                <option value="1" <%= settings.features.hasHeroBanner ? 'selected' : '' %>>Yes - Enabled</option>
                <option value="0" <%= !settings.features.hasHeroBanner ? 'selected' : '' %>>No - Hide Banner</option>
              </select>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>Badge Text</label>
                <input type="text" name="hero_badge" class="form-control" value="<%= settings.hero.badge %>" placeholder="e.g. LIVE MAINNET SYNCHRONIZED">
              </div>
              <div class="form-group">
                <label>Headline Title</label>
                <input type="text" name="hero_title" class="form-control" value="<%= settings.hero.title %>" placeholder="e.g. MyCoin Next-Gen Block Explorer">
              </div>
            </div>

            <div class="form-group">
              <label>Description Subtitle</label>
              <textarea name="hero_subtitle" class="form-control" rows="3"><%= settings.hero.subtitle %></textarea>
            </div>

            <div class="form-group">
              <label>Custom Hero Image URL (optional, defaults to coin logo)</label>
              <input type="text" name="hero_image" class="form-control" value="<%= settings.hero.image %>" placeholder="https://example.com/hero-art.png">
            </div>

            <button type="submit" class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Save Hero Banner</button>
          </form>
        </div>
      <% } %>

      <!-- TAB 3: MASTERNODES / SMARTNODES TOGGLE -->
      <% if (tab === 'masternodes') { %>
        <div class="admin-card">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-share-nodes" style="color: #a855f7;"></i> Masternodes / Smartnodes Page Configuration
          </h2>
          <form action="/<%= adminSlug %>/update-masternodes" method="POST">
            <div class="form-group">
              <label>Enable Masternodes / Smartnodes Feature?</label>
              <select name="has_masternodes" class="form-control">
                <option value="1" <%= settings.features.hasMasternodes ? 'selected' : '' %>>Yes - Enabled (Displays navigation link & stats card)</option>
                <option value="0" <%= !settings.features.hasMasternodes ? 'selected' : '' %>>No - Disabled (For coins without masternodes)</option>
              </select>
            </div>

            <div class="form-group">
              <label>Terminology Label</label>
              <input type="text" name="masternode_label" class="form-control" value="<%= settings.features.masternodeLabel || 'Smartnodes' %>" placeholder="e.g. Smartnodes, Masternodes, Supernodes">
              <small style="color: #64748b; font-size: 0.8rem; display: block; margin-top: 0.3rem;">This replaces the label everywhere on the navbar and dashboard.</small>
            </div>

            <button type="submit" class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Save Masternode Settings</button>
          </form>
        </div>
      <% } %>

      <!-- TAB 4: THEME & COLOR CUSTOMIZER -->
      <% if (tab === 'theme') { %>
        <div class="admin-card">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-palette" style="color: #ec4899;"></i> Explorer Appearance & Theme Customizer
          </h2>
          <form action="/<%= adminSlug %>/update-theme" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label>Typography Font</label>
                <select name="theme_font" class="form-control">
                  <% ['Outfit', 'Inter', 'Poppins', 'Roboto', 'Space Grotesk', 'Montserrat'].forEach(f => { %>
                    <option value="<%= f %>" <%= settings.theme.font === f ? 'selected' : '' %>><%= f %></option>
                  <% }); %>
                </select>
              </div>
              <div class="form-group">
                <label>Background Mode</label>
                <select name="theme_bg_type" class="form-control">
                  <option value="color" <%= settings.theme.bgType === 'color' ? 'selected' : '' %>>Solid Color</option>
                  <option value="gradient" <%= settings.theme.bgType === 'gradient' ? 'selected' : '' %>>Sleek Radial Gradient</option>
                  <option value="image" <%= settings.theme.bgType === 'image' ? 'selected' : '' %>>Custom Background Image</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label>Background Image URL (used if Background Mode is Image)</label>
              <input type="text" name="theme_bg_image" class="form-control" value="<%= settings.theme.bgImage %>" placeholder="https://images.unsplash.com/... or /img/bg.jpg">
            </div>

            <div class="form-row-3">
              <div class="form-group">
                <label>Background Color</label>
                <input type="color" name="theme_bg_color" class="form-control" value="<%= settings.theme.bgColor || '#0b0f19' %>" style="height: 42px; padding: 0.2rem 0.5rem;">
              </div>
              <div class="form-group">
                <label>Card / Box Background</label>
                <input type="text" name="theme_card_bg" class="form-control" value="<%= settings.theme.cardBg || 'rgba(17, 24, 39, 0.75)' %>">
              </div>
              <div class="form-group">
                <label>Card / Box Border</label>
                <input type="text" name="theme_card_border" class="form-control" value="<%= settings.theme.cardBorder || 'rgba(255, 255, 255, 0.08)' %>">
              </div>
            </div>

            <div class="form-row-3">
              <div class="form-group">
                <label>Primary Text Color</label>
                <input type="color" name="theme_text_primary" class="form-control" value="<%= settings.theme.textPrimary || '#ffffff' %>" style="height: 42px; padding: 0.2rem 0.5rem;">
              </div>
              <div class="form-group">
                <label>Muted Subtitle Color</label>
                <input type="color" name="theme_text_secondary" class="form-control" value="<%= settings.theme.textSecondary || '#9ca3af' %>" style="height: 42px; padding: 0.2rem 0.5rem;">
              </div>
              <div class="form-group">
                <label>Primary Accent Color (Buttons, Highlights)</label>
                <input type="color" name="theme_accent_color" class="form-control" value="<%= settings.theme.accentColor || '#10b981' %>" style="height: 42px; padding: 0.2rem 0.5rem;">
              </div>
            </div>

            <button type="submit" class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Apply Theme</button>
          </form>
        </div>
      <% } %>

      <!-- TAB 5: SOCIAL MEDIA & PRICE TRACKER LINKS -->
      <% if (tab === 'socials') { %>
        <% 
          const socialPlatforms = [
            'Altcointalks',
            'BeerMoneyForum',
            'Bitcoin Garden',
            'Bitcointalk',
            'CoinCheckup',
            'CoinCodex',
            'CoinGecko',
            'CoinMarketCap',
            'CoinPaprika',
            'CryptoTalk',
            'Custom',
            'DexScreener',
            'DexTools',
            'Discord',
            'Explorer',
            'Facebook',
            'GitHub',
            'GitLab',
            'Instagram',
            'LinkedIn',
            'LiveCoinWatch',
            'Mastodon',
            'Matrix / Element',
            'Medium',
            'MiningPoolStats',
            'Official Website',
            'Reddit',
            'Substack',
            'Telegram',
            'Threads',
            'TikTok',
            'Twitter / X',
            'WhatsApp',
            'Whitepaper',
            'YouTube'
          ];
        %>
        <div class="admin-card">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-share-from-square" style="color: #3b82f6;"></i> Social Profiles & Crypto Forums
          </h2>
          <p style="color: #94a3b8; font-size: 0.85rem; margin-bottom: 1.5rem;">Add links with respective platforms from the dropdown. These will display in the footer with custom brand icons.</p>

          <form action="/<%= adminSlug %>/update-socials" method="POST">
            <div id="socialsContainer">
              <% (settings.socialLinks || []).forEach((item, index) => { %>
                <div class="dynamic-item-row">
                  <select name="platforms[]" class="form-control" style="width: 220px;">
                    <% socialPlatforms.forEach(p => { %>
                      <option value="<%= p %>" <%= (item.platform && item.platform.toLowerCase() === p.toLowerCase()) ? 'selected' : '' %>><%= p %></option>
                    <% }); %>
                  </select>
                  <input type="text" name="titles[]" class="form-control" value="<%= item.title %>" placeholder="Title / Label">
                  <input type="text" name="urls[]" class="form-control" value="<%= item.url %>" placeholder="https://..." required>
                  <button type="button" class="btn-remove" onclick="this.parentElement.remove()"><i class="fa-solid fa-trash"></i></button>
                </div>
              <% }); %>
            </div>

            <button type="button" class="btn-add" onclick="addSocialRow()"><i class="fa-solid fa-plus"></i> Add Profile / Link</button>
            <div style="margin-top: 1.5rem;">
              <button type="submit" class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Save Social Links</button>
            </div>
          </form>
        </div>

        <script>
          const availablePlatforms = <%- JSON.stringify(socialPlatforms) %>;
          function addSocialRow() {
            const container = document.getElementById('socialsContainer');
            const div = document.createElement('div');
            div.className = 'dynamic-item-row';
            let optionsHtml = '';
            availablePlatforms.forEach(p => {
              const sel = (p === 'Altcointalks') ? 'selected' : '';
              optionsHtml += `<option value="${p}" ${sel}>${p}</option>`;
            });
            div.innerHTML = `
              <select name="platforms[]" class="form-control" style="width: 220px;">
                ${optionsHtml}
              </select>
              <input type="text" name="titles[]" class="form-control" placeholder="Title / Label">
              <input type="text" name="urls[]" class="form-control" placeholder="https://..." required>
              <button type="button" class="btn-remove" onclick="this.parentElement.remove()"><i class="fa-solid fa-trash"></i></button>
            `;
            container.appendChild(div);
          }
        </script>
      <% } %>

      <!-- TAB 6: MARKETS & EXCHANGES -->
      <% if (tab === 'exchanges') { %>
        <div class="admin-card">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-building-columns" style="color: #f59e0b;"></i> Listed Exchanges & Trading Pairs
          </h2>
          <p style="color: #94a3b8; font-size: 0.85rem; margin-bottom: 1.5rem;">Configure exchanges shown on the /market page with direct "Trade Now" links.</p>

          <form action="/<%= adminSlug %>/update-exchanges" method="POST">
            <div id="exchangesContainer">
              <% (settings.exchanges || []).forEach((ex, index) => { %>
                <div class="dynamic-item-row" style="flex-wrap: wrap;">
                  <input type="text" name="names[]" class="form-control" value="<%= ex.name %>" placeholder="Exchange Name (e.g. Xeggex)" style="flex: 1; min-width: 140px;">
                  <input type="text" name="pairs[]" class="form-control" value="<%= ex.pair %>" placeholder="Pair (e.g. <%= coin.symbol %>/USDT)" style="flex: 1; min-width: 120px;">
                  <input type="text" name="pair_urls[]" class="form-control" value="<%= ex.pair_url %>" placeholder="Trade URL (https://...)" style="flex: 2; min-width: 200px;">
                  <input type="text" name="ticker_urls[]" class="form-control" value="<%= ex.ticker_url %>" placeholder="Optional Ticker API URL" style="flex: 2; min-width: 200px;">
                  <button type="button" class="btn-remove" onclick="this.parentElement.remove()"><i class="fa-solid fa-trash"></i></button>
                </div>
              <% }); %>
            </div>

            <button type="button" class="btn-add" onclick="addExchangeRow()"><i class="fa-solid fa-plus"></i> Add Listed Exchange</button>
            <div style="margin-top: 1.5rem;">
              <button type="submit" class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Save Listed Exchanges</button>
            </div>
          </form>
        </div>

        <script>
          function addExchangeRow() {
            const container = document.getElementById('exchangesContainer');
            const div = document.createElement('div');
            div.className = 'dynamic-item-row';
            div.style.flexWrap = 'wrap';
            div.innerHTML = `
              <input type="text" name="names[]" class="form-control" placeholder="Exchange Name (e.g. Xeggex)" style="flex: 1; min-width: 140px;">
              <input type="text" name="pairs[]" class="form-control" placeholder="Pair (e.g. <%= coin.symbol %>/USDT)" style="flex: 1; min-width: 120px;">
              <input type="text" name="pair_urls[]" class="form-control" placeholder="Trade URL (https://...)" style="flex: 2; min-width: 200px;">
              <input type="text" name="ticker_urls[]" class="form-control" placeholder="Optional Ticker API URL" style="flex: 2; min-width: 200px;">
              <button type="button" class="btn-remove" onclick="this.parentElement.remove()"><i class="fa-solid fa-trash"></i></button>
            `;
            container.appendChild(div);
          }
        </script>
      <% } %>

      <!-- TAB 7: FOOTER CONTENT & CLICKABLE LINKS -->
      <% if (tab === 'footer') { %>
        <div class="admin-card">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-bars-staggered" style="color: #6366f1;"></i> Footer Text & Clickable Links Editor
          </h2>
          <p style="color: #94a3b8; font-size: 0.85rem; margin-bottom: 1.5rem;">Customize the bottom copyright notice and add custom clickable links for your website, docs, or sponsors.</p>

          <div style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.25); border-radius: 12px; padding: 1.25rem; margin-bottom: 1.5rem;">
            <div style="font-weight: 700; color: #a5b4fc; font-size: 0.95rem; margin-bottom: 0.6rem; display: flex; align-items: center; gap: 0.5rem;">
              <i class="fa-solid fa-circle-question"></i> How to add clickable links in the footer:
            </div>
            <div style="font-size: 0.85rem; color: #cbd5e1; line-height: 1.7;">
              <strong>1. Markdown Link format (Quickest):</strong>
              <br>Wrap the link text in brackets and the URL in parentheses, for example:
              <br><code style="background: rgba(0,0,0,0.35); padding: 3px 8px; border-radius: 6px; color: #38bdf8; display: inline-block; margin: 4px 0;">[Global Ads Media](https://globaladsmedia.us)</code>
              <br>Full footer notice example:
              <br><code style="background: rgba(0,0,0,0.35); padding: 3px 8px; border-radius: 6px; color: #f1f5f9; display: inline-block; margin: 4px 0;">Global Crypto Explorer © {year}. Developed with ❤️ by [Global Ads Media](https://globaladsmedia.us) • All rights reserved.<br>• <strong>Dynamic Year:</strong> Type <code style="background: rgba(0,0,0,0.35); padding: 2px 6px; border-radius: 4px; color: #a7f3d0;">{year}</code> to automatically display the current year.</code>
              <br><br>
              <strong>2. Direct HTML Tag format:</strong>
              <br><code style="background: rgba(0,0,0,0.35); padding: 3px 8px; border-radius: 6px; color: #38bdf8; display: inline-block; margin: 4px 0;">&lt;a href="https://globaladsmedia.us" target="_blank"&gt;Global Ads Media&lt;/a&gt;</code>
              <br><br>
              <strong>3. Standalone Links:</strong>
              <br>Use the <strong>"Add Clickable Link"</strong> button below to append individual external links (e.g. Terms, Documentation, Whitepaper).
            </div>
          </div>

          <form action="/<%= adminSlug %>/update-footer" method="POST">
            <div class="form-group">
              <label>Footer Copyright Notice (supports markdown links [Title](url) and HTML)</label>
              <input type="text" name="footer_text" class="form-control" value="<%= settings.footer.text %>" placeholder="Global Crypto Explorer © 2026. Developed by [Global Ads Media](https://globaladsmedia.us)">
            </div>

            <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #94a3b8; margin-bottom: 0.6rem; margin-top: 1.5rem;">
              Custom Clickable Footer Links
            </label>
            <div id="footerLinksContainer">
              <% (settings.footer.links || []).forEach(link => { %>
                <div class="dynamic-item-row">
                  <input type="text" name="link_titles[]" class="form-control" value="<%= link.title %>" placeholder="Link Title (e.g. Privacy Policy)" style="flex: 1;">
                  <input type="text" name="link_urls[]" class="form-control" value="<%= link.url %>" placeholder="https://..." style="flex: 2;" required>
                  <button type="button" class="btn-remove" onclick="this.parentElement.remove()"><i class="fa-solid fa-trash"></i></button>
                </div>
              <% }); %>
            </div>

            <button type="button" class="btn-add" onclick="addFooterLinkRow()"><i class="fa-solid fa-plus"></i> Add Clickable Link</button>

            <div style="margin-top: 1.5rem;">
              <button type="submit" class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Save Footer</button>
            </div>
          </form>
        </div>

        <script>
          function addFooterLinkRow() {
            const container = document.getElementById('footerLinksContainer');
            const div = document.createElement('div');
            div.className = 'dynamic-item-row';
            div.innerHTML = `
              <input type="text" name="link_titles[]" class="form-control" placeholder="Link Title (e.g. Whitepaper)" style="flex: 1;">
              <input type="text" name="link_urls[]" class="form-control" placeholder="https://..." style="flex: 2;" required>
              <button type="button" class="btn-remove" onclick="this.parentElement.remove()"><i class="fa-solid fa-trash"></i></button>
            `;
            container.appendChild(div);
          }
        </script>
      <% } %>

      <!-- TAB 8: ADMIN PROFILE & SECURITY -->
      <% if (tab === 'profile') { %>
        <div class="admin-card">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-user-gear" style="color: #10b981;"></i> Administrator Profile & Password
          </h2>
          <form action="/<%= adminSlug %>/update-profile" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label>Admin Name</label>
                <input type="text" name="admin_name" class="form-control" value="<%= settings.adminName %>" required>
              </div>
              <div class="form-group">
                <label>Admin Email</label>
                <input type="email" name="admin_email" class="form-control" value="<%= settings.adminEmail %>" required>
              </div>
            </div>

            <div class="form-group">
              <label>Admin Custom URL Slug (e.g. 'gamus' -> domain.com/gamus)</label>
              <div style="display: flex; align-items: center; background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 10px; padding-left: 0.9rem;">
                <span style="color: #64748b; font-size: 0.9rem;">domain.com/</span>
                <input type="text" name="admin_slug" class="form-control" value="<%= settings.adminSlug %>" style="border: none; background: transparent; padding-left: 0.2rem;" required pattern="[a-zA-Z0-9_-]+">
              </div>
            </div>

            <hr style="border-color: rgba(255, 255, 255, 0.08); margin: 1.5rem 0;">
            <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 1rem; color: #f59e0b;">
              <i class="fa-solid fa-key"></i> Change Password
            </h3>

            <div class="form-group">
              <label>Current Password (required to save changes)</label>
              <input type="password" name="current_password" class="form-control" placeholder="••••••••" required>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>New Password (leave blank if not changing)</label>
                <input type="password" name="new_password" class="form-control" placeholder="••••••••">
              </div>
              <div class="form-group">
                <label>Confirm New Password</label>
                <input type="password" name="new_password_confirm" class="form-control" placeholder="••••••••">
              </div>
            </div>

            <button type="submit" class="btn-save"><i class="fa-solid fa-shield-halved"></i> Update Profile & Security</button>
          </form>
        </div>
      <% } %>

    
      <!-- TAB 9: SYSTEM UPDATES & GITHUB SYNC -->
      <% if (tab === 'updates') { %>
        <% 
          const localCommit = (updateInfo && updateInfo.local) ? updateInfo.local : { shortSha: 'HEAD', msg: 'Current Build', date: 'Active' };
          const remoteCommit = (updateInfo && updateInfo.remote) ? updateInfo.remote : null;
          const hasUpdate = (updateInfo && updateInfo.updateAvailable);
        %>
        <div class="admin-card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
            <div>
              <h2 style="font-size: 1.35rem; font-weight: 700; margin-bottom: 0.35rem; display: flex; align-items: center; gap: 0.6rem;">
                <i class="fa-solid fa-cloud-arrow-down" style="color: #38bdf8;"></i> System Updates & GitHub Sync
              </h2>
              <p style="color: #94a3b8; font-size: 0.88rem;">Inspect your server's active commit against the official GitHub repository and perform seamless 1-click updates.</p>
            </div>
            <button type="button" class="btn-outline" onclick="checkUpdatesNow()" id="btnCheckUpdates" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.2rem; font-size: 0.88rem; border-radius: 8px; border-color: rgba(56, 189, 248, 0.4); color: #38bdf8; background: rgba(56, 189, 248, 0.08);">
              <i class="fa-solid fa-arrows-rotate" id="checkSpinner"></i> Check for Updates
            </button>
          </div>

          <!-- 3-Column Status Grid -->
          <div class="stat-grid" style="margin-bottom: 2rem;">
            <!-- Installed Server Commit -->
            <div class="stat-card" style="border-left: 3px solid #3b82f6;">
              <div class="stat-label"><i class="fa-solid fa-server"></i> Installed on Server</div>
              <div class="stat-value mono text-primary" style="font-size: 1.3rem; margin: 0.4rem 0;">
                <%= localCommit.shortSha %>
                <span class="badge badge-cyan" style="font-size: 0.68rem; margin-left: 0.4rem; vertical-align: middle;">v<%= localCommit.version || '1.0.0' %></span>
              </div>
              <div class="stat-sub" style="color: #e2e8f0; font-weight: 500; font-size: 0.82rem; line-height: 1.4;">
                <%= localCommit.msg %>
              </div>
              <div style="font-size: 0.75rem; color: #64748b; margin-top: 0.4rem;">
                <i class="fa-regular fa-clock"></i> <%= localCommit.date %>
              </div>
            </div>

            <!-- Latest on GitHub -->
            <div class="stat-card" style="border-left: 3px solid #38bdf8;">
              <div class="stat-label"><i class="fa-brands fa-github"></i> Latest on GitHub</div>
              <div class="stat-value mono text-cyan" style="font-size: 1.3rem; margin: 0.4rem 0;" id="remoteCommitSha">
                <%= remoteCommit ? remoteCommit.shortSha : 'Querying...' %>
                <% if (remoteCommit) { %>
                  <a href="https://github.com/gamgsp/global-crypto-explorer/commit/<%= remoteCommit.sha %>" target="_blank" rel="noopener" style="font-size: 0.72rem; color: #38bdf8; text-decoration: underline; margin-left: 0.5rem;" title="View commit on GitHub">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i> Diff
                  </a>
                <% } %>
              </div>
              <div class="stat-sub" id="remoteCommitMsg" style="color: #e2e8f0; font-weight: 500; font-size: 0.82rem; line-height: 1.4;">
                <%= remoteCommit ? remoteCommit.msg : 'Checking remote repository...' %>
              </div>
              <div style="font-size: 0.75rem; color: #64748b; margin-top: 0.4rem;" id="remoteCommitMeta">
                <% if (remoteCommit) { %>
                  <i class="fa-regular fa-user"></i> <%= remoteCommit.author %> &bull; <%= new Date(remoteCommit.date).toLocaleDateString() %>
                <% } %>
              </div>
            </div>

            <!-- System Update State -->
            <div class="stat-card" style="border-left: 3px solid <%= hasUpdate ? '#f59e0b' : '#10b981' %>;">
              <div class="stat-label"><i class="fa-solid fa-shield-halved"></i> Update Status</div>
              <div class="stat-value mono" style="font-size: 1.15rem; margin: 0.4rem 0;" id="systemStatusText">
                <% if (hasUpdate) { %>
                  <span style="color: #f59e0b; display: inline-flex; align-items: center; gap: 0.4rem;">
                    <i class="fa-solid fa-circle-exclamation"></i> Update Available
                  </span>
                <% } else { %>
                  <span style="color: #10b981; display: inline-flex; align-items: center; gap: 0.4rem;">
                    <i class="fa-solid fa-circle-check"></i> Up to Date
                  </span>
                <% } %>
              </div>
              <div class="stat-sub" style="font-size: 0.82rem; color: #94a3b8;">
                <% if (hasUpdate) { %>
                  New commits ready to pull from GitHub.
                <% } else { %>
                  Server is running the latest official build.
                <% } %>
              </div>
              <div style="font-size: 0.75rem; color: #64748b; margin-top: 0.4rem;">
                Last checked: <span id="lastCheckedTime"><%= updateInfo ? updateInfo.checkedAt : 'Just now' %></span>
              </div>
            </div>
          </div>

          <!-- Update Information & Action Card -->
          <div id="updateActionBox" style="background: <%= hasUpdate ? 'linear-gradient(135deg, rgba(245, 158, 11, 0.12), rgba(30, 41, 59, 0.6))' : 'linear-gradient(135deg, rgba(16, 185, 129, 0.08), rgba(30, 41, 59, 0.6))' %>; border: 1px solid <%= hasUpdate ? 'rgba(245, 158, 11, 0.35)' : 'rgba(16, 185, 129, 0.25)' %>; border-radius: 14px; padding: 1.75rem; margin-bottom: 1.75rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem;">
              <div style="flex: 1; min-width: 280px;">
                <h3 style="font-size: 1.15rem; font-weight: 700; color: #fff; margin-bottom: 0.45rem; display: flex; align-items: center; gap: 0.6rem;">
                  <% if (hasUpdate) { %>
                    <i class="fa-solid fa-gift" style="color: #f59e0b;"></i> New Version Published on GitHub
                  <% } else { %>
                    <i class="fa-solid fa-circle-check" style="color: #10b981;"></i> Your Server is Fully Synchronized
                  <% } %>
                </h3>
                <p style="color: #cbd5e1; font-size: 0.9rem; line-height: 1.5; margin-bottom: 0.6rem;">
                  <% if (hasUpdate && remoteCommit) { %>
                    <strong>Update details:</strong> <span style="color: #38bdf8;"><%= remoteCommit.msg %></span> (commit <code><%= remoteCommit.shortSha %></code> by <%= remoteCommit.author %>).
                  <% } else { %>
                    Running commit <code><%= localCommit.shortSha %></code>. You are on the latest official build from <a href="https://github.com/gamgsp/global-crypto-explorer" target="_blank" rel="noopener" style="color: #38bdf8; text-decoration: underline;">gamgsp/global-crypto-explorer</a>.
                  <% } %>
                </p>
                <div style="font-size: 0.8rem; color: #94a3b8;">
                  <i class="fa-solid fa-info-circle"></i> Update automatically executes <code>git fetch origin main && git reset --hard origin/main && npm install --omit=dev</code> and restarts <code>global-crypto-explorer.service</code>.
                </div>
              </div>

              <div>
                <% if (hasUpdate) { %>
                  <button type="button" class="btn-save" id="btnRunUpdate" onclick="applyUpdateNow()" style="background: linear-gradient(135deg, #0284c7, #2563eb); border: none; font-size: 1rem; padding: 0.95rem 2rem; border-radius: 10px; cursor: pointer; font-weight: 700; box-shadow: 0 4px 18px rgba(37, 99, 235, 0.45); display: inline-flex; align-items: center; gap: 0.6rem; color: #fff;">
                    <i class="fa-solid fa-cloud-arrow-down"></i> Update App from GitHub Now
                  </button>
                <% } else { %>
                  <button type="button" class="btn-outline" id="btnRunUpdate" onclick="applyUpdateNow()" style="border-color: rgba(56, 189, 248, 0.5); color: #38bdf8; font-size: 0.9rem; padding: 0.8rem 1.6rem; border-radius: 10px; cursor: pointer; font-weight: 600; display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(56, 189, 248, 0.08);">
                    <i class="fa-solid fa-arrows-rotate"></i> Force Re-Sync / Update from GitHub
                  </button>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Verbose Live Terminal Progress Console Box -->
          <div id="updateProgressConsole" style="display: none; background: #070a13; border: 1px solid rgba(56, 189, 248, 0.35); border-radius: 14px; padding: 1.5rem; margin-top: 1.75rem; box-shadow: 0 8px 30px rgba(0,0,0,0.5);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.08);">
              <span style="font-weight: 700; font-size: 0.95rem; color: #38bdf8; display: flex; align-items: center; gap: 0.6rem;">
                <i class="fa-solid fa-terminal"></i> Live Update Progress Console
              </span>
              <span class="badge badge-cyan" id="updateProgressBadge" style="padding: 4px 10px; font-size: 0.75rem;">
                <span class="pulse-dot"></span> In Progress...
              </span>
            </div>

            <pre id="updateTerminalLog" style="background: rgba(0, 0, 0, 0.65); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px; padding: 1.25rem; color: #4ade80; font-family: var(--font-mono, 'JetBrains Mono', monospace); font-size: 0.82rem; line-height: 1.55; max-height: 280px; overflow-y: auto; white-space: pre-wrap; margin: 0;">Initiating GitHub update process...</pre>

            <div id="updateRestartNotice" style="display: none; margin-top: 1.25rem; background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 10px; padding: 1rem; color: #facc15; font-size: 0.9rem; font-weight: 600; display: flex; align-items: center; gap: 0.75rem;">
              <i class="fa-solid fa-spinner fa-spin" style="font-size: 1.2rem;"></i>
              <div>
                Service is restarting with the new build. Automatically reconnecting in <span id="restartSeconds" style="font-size: 1.1rem; color: #fff; font-weight: 800;">5</span>s...
              </div>
            </div>
          </div>
        </div>

        <script>
          async function checkUpdatesNow() {
            const btn = document.getElementById('btnCheckUpdates');
            const spinner = document.getElementById('checkSpinner');
            if (spinner) spinner.className = 'fa-solid fa-spinner fa-spin';
            if (btn) btn.disabled = true;

            try {
              const res = await fetch('/<%= adminSlug %>/check-update');
              const data = await res.json();
              if (data.success) {
                window.location.href = '/<%= adminSlug %>?tab=updates&msg=' + encodeURIComponent(data.updateAvailable ? 'New update detected on GitHub: ' + (data.remote ? data.remote.shortSha : '') : 'Your system is fully up to date!');
              } else {
                alert('Update check failed: ' + (data.error || 'Unknown error'));
              }
            } catch (err) {
              alert('Network error while checking updates from GitHub.');
            } finally {
              if (spinner) spinner.className = 'fa-solid fa-arrows-rotate';
              if (btn) btn.disabled = false;
            }
          }

          async function applyUpdateNow() {
            if (!confirm('Are you sure you want to update the Global Crypto Explorer to the latest GitHub build?\\n\\nThe app will fetch latest commits, install dependencies, and cleanly restart the service.')) {
              return;
            }

            const btn = document.getElementById('btnRunUpdate');
            const consoleBox = document.getElementById('updateProgressConsole');
            const terminalLog = document.getElementById('updateTerminalLog');
            const restartNotice = document.getElementById('updateRestartNotice');
            const progressBadge = document.getElementById('updateProgressBadge');

            if (btn) btn.disabled = true;
            if (consoleBox) {
              consoleBox.style.display = 'block';
              consoleBox.scrollIntoView({ behavior: 'smooth' });
            }

            terminalLog.textContent = '[Step 1/3] Connecting to official GitHub repository (gamgsp/global-crypto-explorer)...\\n';
            terminalLog.textContent += '[Step 2/3] Executing: git fetch origin main && git reset --hard origin/main && npm install --omit=dev...\\n\\n';

            try {
              const res = await fetch('/<%= adminSlug %>/apply-update', { method: 'POST' });
              const data = await res.json();

              if (data.success) {
                terminalLog.textContent += '=== VERBOSE OUTPUT FROM GIT & NPM ===\\n';
                if (data.output) {
                  terminalLog.textContent += data.output + '\\n';
                }
                terminalLog.textContent += '\\n[Step 3/3] ' + data.message + '\\n';
                
                if (progressBadge) {
                  progressBadge.className = 'badge badge-success';
                  progressBadge.textContent = 'Restarting Service';
                }
                if (restartNotice) {
                  restartNotice.style.display = 'flex';
                }

                let sec = 5;
                const secEl = document.getElementById('restartSeconds');
                const interval = setInterval(() => {
                  sec--;
                  if (secEl) secEl.textContent = sec;
                  if (sec <= 0) {
                    clearInterval(interval);
                    window.location.href = '/<%= adminSlug %>?tab=updates&msg=' + encodeURIComponent('Successfully updated to the latest build!');
                  }
                }, 1000);
              } else {
                terminalLog.textContent += '\\n[ERROR] Update failed:\\n' + (data.error || 'Unknown error');
                if (progressBadge) {
                  progressBadge.className = 'badge badge-danger';
                  progressBadge.textContent = 'Failed';
                }
                if (btn) btn.disabled = false;
              }
            } catch (err) {
              terminalLog.textContent += '\\n[NOTICE] Connection closed as server restarted with new build.\\nReconnecting...';
              setTimeout(() => {
                window.location.href = '/<%= adminSlug %>?tab=updates&msg=' + encodeURIComponent('Service restarted successfully with new build!');
              }, 4000);
            }
          }
        </script>
      <% } %>

    </main>
  </div>
</body>
</html>
