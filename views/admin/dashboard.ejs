<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Control Panel - <%= coin.name || appName %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background-color: #0b0f19;
      font-family: 'Outfit', sans-serif;
      min-height: 100vh;
      color: #fff;
    }
    .admin-layout {
      display: flex;
      min-height: 100vh;
    }
    /* Left Sidebar */
    .admin-sidebar {
      width: 270px;
      min-width: 270px;
      background: rgba(15, 23, 42, 0.95);
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      height: 100vh;
      z-index: 50;
      backdrop-filter: blur(16px);
    }
    .sidebar-header {
      padding: 1.5rem 1.25rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .sidebar-logo-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: linear-gradient(135deg, #10b981, #3b82f6);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
    }
    .sidebar-nav {
      flex: 1;
      padding: 1.25rem 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      overflow-y: auto;
    }
    .sidebar-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
      border-radius: 10px;
      color: #94a3b8;
      text-decoration: none;
      font-size: 0.92rem;
      font-weight: 600;
      transition: all 0.2s;
    }
    .sidebar-item i {
      width: 20px;
      font-size: 1.05rem;
      text-align: center;
    }
    .sidebar-item:hover {
      color: #fff;
      background: rgba(255, 255, 255, 0.05);
      transform: translateX(3px);
    }
    .sidebar-item.active {
      color: #fff;
      background: #10b981;
      box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
      transform: none;
    }
    .sidebar-footer {
      padding: 1.25rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    /* Main Content Area */
    .admin-main {
      flex: 1;
      padding: 2rem 2.5rem;
      overflow-y: auto;
      max-width: calc(100vw - 270px);
    }
    .main-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .admin-card {
      background: rgba(17, 24, 39, 0.75);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 2.25rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      margin-bottom: 2rem;
    }
    .form-group {
      margin-bottom: 1.35rem;
    }
    .form-group label {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      color: #94a3b8;
      margin-bottom: 0.45rem;
    }
    .form-control {
      width: 100%;
      background: rgba(15, 23, 42, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px;
      padding: 0.75rem 0.95rem;
      color: #fff;
      font-size: 0.95rem;
    }
    .form-control:focus {
      outline: none;
      border-color: #10b981;
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
    }
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.35rem;
    }
    .form-row-3 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1.35rem;
    }
    .btn-save {
      background: #10b981;
      color: #fff;
      border: none;
      padding: 0.8rem 1.6rem;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.2s;
    }
    .btn-save:hover {
      background: #059669;
      transform: translateY(-1px);
    }
    .alert-success {
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid #10b981;
      color: #6ee7b7;
      padding: 0.85rem 1.25rem;
      border-radius: 10px;
      margin-bottom: 1.5rem;
      font-size: 0.9rem;
    }
    .alert-danger {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid #ef4444;
      color: #fca5a5;
      padding: 0.85rem 1.25rem;
      border-radius: 10px;
      margin-bottom: 1.5rem;
      font-size: 0.9rem;
    }
    .dynamic-item-row {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      margin-bottom: 0.75rem;
      background: rgba(15, 23, 42, 0.5);
      padding: 0.65rem 0.85rem;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .btn-remove {
      background: rgba(239, 68, 68, 0.2);
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: #f87171;
      width: 36px;
      height: 36px;
      border-radius: 8px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }
    .btn-remove:hover {
      background: #ef4444;
      color: #fff;
    }
    .btn-add {
      background: rgba(255, 255, 255, 0.08);
      border: 1px dashed rgba(255, 255, 255, 0.2);
      color: #cbd5e1;
      padding: 0.65rem 1.25rem;
      border-radius: 10px;
      cursor: pointer;
      font-size: 0.85rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.5rem;
    }
    .btn-add:hover {
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
    }
    @media (max-width: 900px) {
      .admin-layout {
        flex-direction: column;
      }
      .admin-sidebar {
        width: 100%;
        height: auto;
        position: relative;
      }
      .admin-main {
        max-width: 100%;
        padding: 1.5rem;
      }
      .form-row, .form-row-3 {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="admin-layout">
    <!-- LEFT SIDEBAR -->
    <aside class="admin-sidebar">
      <div class="sidebar-header">
        <div class="sidebar-logo-icon">
          <i class="fa-solid fa-gear" style="color: #fff; font-size: 1.2rem;"></i>
        </div>
        <div>
          <div style="font-weight: 800; font-size: 1.05rem; color: #fff;">Admin Portal</div>
          <div style="font-size: 0.75rem; color: #94a3b8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 160px;">
            <strong style="color: #10b981;"><%= coin.name %></strong>
          </div>
        </div>
      </div>

      <!-- Navigation Menu -->
      <nav class="sidebar-nav">
        <a href="/<%= adminSlug %>?tab=general" class="sidebar-item <%= (!tab || tab === 'general') ? 'active' : '' %>">
          <i class="fa-solid fa-coins"></i> <span>Coin & Node</span>
        </a>
        <a href="/<%= adminSlug %>?tab=hero" class="sidebar-item <%= tab === 'hero' ? 'active' : '' %>">
          <i class="fa-solid fa-bullhorn"></i> <span>Hero Banner</span>
        </a>
        <a href="/<%= adminSlug %>?tab=masternodes" class="sidebar-item <%= tab === 'masternodes' ? 'active' : '' %>">
          <i class="fa-solid fa-share-nodes"></i> <span>Masternodes</span>
        </a>
        <a href="/<%= adminSlug %>?tab=theme" class="sidebar-item <%= tab === 'theme' ? 'active' : '' %>">
          <i class="fa-solid fa-palette"></i> <span>Theme & Colors</span>
        </a>
        <a href="/<%= adminSlug %>?tab=socials" class="sidebar-item <%= tab === 'socials' ? 'active' : '' %>">
          <i class="fa-solid fa-share-from-square"></i> <span>Social Links</span>
        </a>
        <a href="/<%= adminSlug %>?tab=exchanges" class="sidebar-item <%= tab === 'exchanges' ? 'active' : '' %>">
          <i class="fa-solid fa-building-columns"></i> <span>Markets / Exchanges</span>
        </a>
        <a href="/<%= adminSlug %>?tab=footer" class="sidebar-item <%= tab === 'footer' ? 'active' : '' %>">
          <i class="fa-solid fa-bars-staggered"></i> <span>Footer Content</span>
        </a>
        <a href="/<%= adminSlug %>?tab=profile" class="sidebar-item <%= tab === 'profile' ? 'active' : '' %>">
          <i class="fa-solid fa-user-gear"></i> <span>Admin Profile</span>
        </a>
      </nav>

      <!-- Sidebar Footer -->
      <div class="sidebar-footer">
        <a href="/" target="_blank" class="btn btn-outline" style="width: 100%; justify-content: center; padding: 0.55rem; font-size: 0.85rem; text-decoration: none;">
          <i class="fa-solid fa-arrow-up-right-from-square"></i> View Explorer
        </a>
        <a href="/<%= adminSlug %>/logout" class="btn btn-danger" style="width: 100%; justify-content: center; padding: 0.55rem; font-size: 0.85rem; text-decoration: none;">
          <i class="fa-solid fa-right-from-bracket"></i> Logout
        </a>
      </div>
    </aside>

    <!-- RIGHT MAIN CONTENT -->
    <main class="admin-main">
      <div class="main-topbar">
        <div>
          <div style="font-size: 0.8rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem;">Control Dashboard</div>
          <h1 style="font-size: 1.5rem; font-weight: 800; color: #fff;">
            <% if (!tab || tab === 'general') { %>Coin & Daemon Settings<% } %>
            <% if (tab === 'hero') { %>Hero Banner Customizer<% } %>
            <% if (tab === 'masternodes') { %>Masternodes Feature Configuration<% } %>
            <% if (tab === 'theme') { %>Theme & Appearance Customizer<% } %>
            <% if (tab === 'socials') { %>Social Profiles & Price Trackers<% } %>
            <% if (tab === 'exchanges') { %>Listed Exchanges & Trading Pairs<% } %>
            <% if (tab === 'footer') { %>Footer Content & Clickable Links<% } %>
            <% if (tab === 'profile') { %>Administrator Profile & Security<% } %>
          </h1>
        </div>

        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <span class="badge badge-success"><span class="pulse-dot"></span> Admin Active</span>
        </div>
      </div>

      <% if (message) { %>
        <div class="alert-success"><i class="fa-solid fa-circle-check"></i> <%= message %></div>
      <% } %>
      <% if (error) { %>
        <div class="alert-danger"><i class="fa-solid fa-triangle-exclamation"></i> <%= error %></div>
      <% } %>

      <!-- TAB 1: COIN & NODE SETTINGS -->
      <% if (!tab || tab === 'general') { %>
        <div class="admin-card">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-coins" style="color: #10b981;"></i> Coin Identity & Daemon Node Settings
          </h2>
          <form action="/<%= adminSlug %>/update-coin" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label>Coin Name</label>
                <input type="text" name="coin_name" class="form-control" value="<%= coin.name %>" required>
              </div>
              <div class="form-group">
                <label>Ticker / Symbol</label>
                <input type="text" name="coin_symbol" class="form-control" value="<%= coin.symbol %>" required>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>Decimals</label>
                <input type="number" name="coin_decimals" class="form-control" value="<%= coin.decimals %>" required>
              </div>
              <div class="form-group">
                <label>Default Chart Timeline</label>
                <select name="chart_default_days" class="form-control">
                  <option value="7" <%= (settings.chart && settings.chart.defaultDays == 7) ? 'selected' : '' %>>Last 7 Days</option>
                  <option value="10" <%= (settings.chart && settings.chart.defaultDays == 10) ? 'selected' : '' %>>Last 10 Days</option>
                  <option value="15" <%= (!settings.chart || !settings.chart.defaultDays || settings.chart.defaultDays == 15) ? 'selected' : '' %>>Last 15 Days</option>
                  <option value="30" <%= (settings.chart && settings.chart.defaultDays == 30) ? 'selected' : '' %>>Last 30 Days (Recommended)</option>
                </select>
              </div>
              <div class="form-group">
                <label>Official Website URL</label>
                <input type="text" name="official_website" class="form-control" value="<%= coin.officialWebsite %>" placeholder="https://mycoin.org">
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>Coin Logo URL</label>
                <input type="text" name="logo_url" class="form-control" value="<%= coin.logo %>" placeholder="https://example.com/logo.png">
              </div>
              <div class="form-group">
                <label>Favicon URL</label>
                <input type="text" name="favicon_url" class="form-control" value="<%= coin.favicon %>" placeholder="https://example.com/favicon.ico">
              </div>
            </div>

            <hr style="border-color: rgba(255, 255, 255, 0.08); margin: 1.5rem 0;">
            <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 1rem; color: #38bdf8;">
              <i class="fa-solid fa-server"></i> Daemon RPC Connection
            </h3>

            <div class="form-row">
              <div class="form-group">
                <label>RPC Host</label>
                <input type="text" name="rpc_host" class="form-control" value="<%= settings.rpc.host %>" required>
              </div>
              <div class="form-group">
                <label>RPC Port</label>
                <input type="number" name="rpc_port" class="form-control" value="<%= settings.rpc.port %>" required>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>RPC Username</label>
                <input type="text" name="rpc_user" class="form-control" value="<%= settings.rpc.user %>" required>
              </div>
              <div class="form-group">
                <label>RPC Password</label>
                <input type="password" name="rpc_password" class="form-control" value="<%= settings.rpc.password %>" required>
              </div>
            </div>

            <button type="submit" class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Save Coin & RPC Settings</button>
          </form>
        </div>
      <% } %>

      <!-- TAB 2: HERO BANNER CUSTOMIZER -->
      <% if (tab === 'hero') { %>
        <div class="admin-card">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-bullhorn" style="color: #38bdf8;"></i> Homepage Hero Banner Customizer
          </h2>
          <form action="/<%= adminSlug %>/update-hero" method="POST">
            <div class="form-group">
              <label>Display Hero Banner on Dashboard?</label>
              <select name="has_hero_banner" class="form-control">
                <option value="1" <%= settings.features.hasHeroBanner ? 'selected' : '' %>>Yes - Enabled</option>
                <option value="0" <%= !settings.features.hasHeroBanner ? 'selected' : '' %>>No - Hide Banner</option>
              </select>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>Badge Text</label>
                <input type="text" name="hero_badge" class="form-control" value="<%= settings.hero.badge %>" placeholder="e.g. LIVE MAINNET SYNCHRONIZED">
              </div>
              <div class="form-group">
                <label>Headline Title</label>
                <input type="text" name="hero_title" class="form-control" value="<%= settings.hero.title %>" placeholder="e.g. MyCoin Next-Gen Block Explorer">
              </div>
            </div>

            <div class="form-group">
              <label>Description Subtitle</label>
              <textarea name="hero_subtitle" class="form-control" rows="3"><%= settings.hero.subtitle %></textarea>
            </div>

            <div class="form-group">
              <label>Custom Hero Image URL (optional, defaults to coin logo)</label>
              <input type="text" name="hero_image" class="form-control" value="<%= settings.hero.image %>" placeholder="https://example.com/hero-art.png">
            </div>

            <button type="submit" class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Save Hero Banner</button>
          </form>
        </div>
      <% } %>

      <!-- TAB 3: MASTERNODES / SMARTNODES TOGGLE -->
      <% if (tab === 'masternodes') { %>
        <div class="admin-card">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-share-nodes" style="color: #a855f7;"></i> Masternodes / Smartnodes Page Configuration
          </h2>
          <form action="/<%= adminSlug %>/update-masternodes" method="POST">
            <div class="form-group">
              <label>Enable Masternodes / Smartnodes Feature?</label>
              <select name="has_masternodes" class="form-control">
                <option value="1" <%= settings.features.hasMasternodes ? 'selected' : '' %>>Yes - Enabled (Displays navigation link & stats card)</option>
                <option value="0" <%= !settings.features.hasMasternodes ? 'selected' : '' %>>No - Disabled (For coins without masternodes)</option>
              </select>
            </div>

            <div class="form-group">
              <label>Terminology Label</label>
              <input type="text" name="masternode_label" class="form-control" value="<%= settings.features.masternodeLabel || 'Smartnodes' %>" placeholder="e.g. Smartnodes, Masternodes, Supernodes">
              <small style="color: #64748b; font-size: 0.8rem; display: block; margin-top: 0.3rem;">This replaces the label everywhere on the navbar and dashboard.</small>
            </div>

            <button type="submit" class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Save Masternode Settings</button>
          </form>
        </div>
      <% } %>

      <!-- TAB 4: THEME & COLOR CUSTOMIZER -->
      <% if (tab === 'theme') { %>
        <div class="admin-card">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-palette" style="color: #ec4899;"></i> Explorer Appearance & Theme Customizer
          </h2>
          <form action="/<%= adminSlug %>/update-theme" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label>Typography Font</label>
                <select name="theme_font" class="form-control">
                  <% ['Outfit', 'Inter', 'Poppins', 'Roboto', 'Space Grotesk', 'Montserrat'].forEach(f => { %>
                    <option value="<%= f %>" <%= settings.theme.font === f ? 'selected' : '' %>><%= f %></option>
                  <% }); %>
                </select>
              </div>
              <div class="form-group">
                <label>Background Mode</label>
                <select name="theme_bg_type" class="form-control">
                  <option value="color" <%= settings.theme.bgType === 'color' ? 'selected' : '' %>>Solid Color</option>
                  <option value="gradient" <%= settings.theme.bgType === 'gradient' ? 'selected' : '' %>>Sleek Radial Gradient</option>
                  <option value="image" <%= settings.theme.bgType === 'image' ? 'selected' : '' %>>Custom Background Image</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label>Background Image URL (used if Background Mode is Image)</label>
              <input type="text" name="theme_bg_image" class="form-control" value="<%= settings.theme.bgImage %>" placeholder="https://images.unsplash.com/... or /img/bg.jpg">
            </div>

            <div class="form-row-3">
              <div class="form-group">
                <label>Background Color</label>
                <input type="color" name="theme_bg_color" class="form-control" value="<%= settings.theme.bgColor || '#0b0f19' %>" style="height: 42px; padding: 0.2rem 0.5rem;">
              </div>
              <div class="form-group">
                <label>Card / Box Background</label>
                <input type="text" name="theme_card_bg" class="form-control" value="<%= settings.theme.cardBg || 'rgba(17, 24, 39, 0.75)' %>">
              </div>
              <div class="form-group">
                <label>Card / Box Border</label>
                <input type="text" name="theme_card_border" class="form-control" value="<%= settings.theme.cardBorder || 'rgba(255, 255, 255, 0.08)' %>">
              </div>
            </div>

            <div class="form-row-3">
              <div class="form-group">
                <label>Primary Text Color</label>
                <input type="color" name="theme_text_primary" class="form-control" value="<%= settings.theme.textPrimary || '#ffffff' %>" style="height: 42px; padding: 0.2rem 0.5rem;">
              </div>
              <div class="form-group">
                <label>Muted Subtitle Color</label>
                <input type="color" name="theme_text_secondary" class="form-control" value="<%= settings.theme.textSecondary || '#9ca3af' %>" style="height: 42px; padding: 0.2rem 0.5rem;">
              </div>
              <div class="form-group">
                <label>Primary Accent Color (Buttons, Highlights)</label>
                <input type="color" name="theme_accent_color" class="form-control" value="<%= settings.theme.accentColor || '#10b981' %>" style="height: 42px; padding: 0.2rem 0.5rem;">
              </div>
            </div>

            <button type="submit" class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Apply Theme</button>
          </form>
        </div>
      <% } %>

      <!-- TAB 5: SOCIAL MEDIA & PRICE TRACKER LINKS -->
      <% if (tab === 'socials') { %>
        <div class="admin-card">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-share-from-square" style="color: #3b82f6;"></i> Social Profiles & Price Trackers
          </h2>
          <p style="color: #94a3b8; font-size: 0.85rem; margin-bottom: 1.5rem;">Add links with respective platforms from the dropdown. These will display in the footer with custom brand icons.</p>

          <form action="/<%= adminSlug %>/update-socials" method="POST">
            <div id="socialsContainer">
              <% (settings.socialLinks || []).forEach((item, index) => { %>
                <div class="dynamic-item-row">
                  <select name="platforms[]" class="form-control" style="width: 220px;">
                    <% const platforms = ['CoinMarketCap', 'CoinGecko', 'CoinPaprika', 'Twitter / X', 'Telegram', 'Discord', 'WhatsApp', 'Facebook', 'Instagram', 'YouTube', 'Reddit', 'GitHub', 'Official Website', 'Explorer', 'Custom']; %>
                    <% platforms.forEach(p => { %>
                      <option value="<%= p %>" <%= item.platform === p ? 'selected' : '' %>><%= p %></option>
                    <% }); %>
                  </select>
                  <input type="text" name="titles[]" class="form-control" value="<%= item.title %>" placeholder="Title / Label">
                  <input type="text" name="urls[]" class="form-control" value="<%= item.url %>" placeholder="https://..." required>
                  <button type="button" class="btn-remove" onclick="this.parentElement.remove()"><i class="fa-solid fa-trash"></i></button>
                </div>
              <% }); %>
            </div>

            <button type="button" class="btn-add" onclick="addSocialRow()"><i class="fa-solid fa-plus"></i> Add Profile / Link</button>
            <div style="margin-top: 1.5rem;">
              <button type="submit" class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Save Social Links</button>
            </div>
          </form>
        </div>

        <script>
          function addSocialRow() {
            const container = document.getElementById('socialsContainer');
            const div = document.createElement('div');
            div.className = 'dynamic-item-row';
            div.innerHTML = `
              <select name="platforms[]" class="form-control" style="width: 220px;">
                <option value="CoinMarketCap">CoinMarketCap</option>
                <option value="CoinGecko">CoinGecko</option>
                <option value="CoinPaprika">CoinPaprika</option>
                <option value="Twitter / X" selected>Twitter / X</option>
                <option value="Telegram">Telegram</option>
                <option value="Discord">Discord</option>
                <option value="WhatsApp">WhatsApp</option>
                <option value="Facebook">Facebook</option>
                <option value="Instagram">Instagram</option>
                <option value="YouTube">YouTube</option>
                <option value="Reddit">Reddit</option>
                <option value="GitHub">GitHub</option>
                <option value="Official Website">Official Website</option>
                <option value="Custom">Custom</option>
              </select>
              <input type="text" name="titles[]" class="form-control" placeholder="Title / Label">
              <input type="text" name="urls[]" class="form-control" placeholder="https://..." required>
              <button type="button" class="btn-remove" onclick="this.parentElement.remove()"><i class="fa-solid fa-trash"></i></button>
            `;
            container.appendChild(div);
          }
        </script>
      <% } %>

      <!-- TAB 6: MARKETS & EXCHANGES -->
      <% if (tab === 'exchanges') { %>
        <div class="admin-card">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-building-columns" style="color: #f59e0b;"></i> Listed Exchanges & Trading Pairs
          </h2>
          <p style="color: #94a3b8; font-size: 0.85rem; margin-bottom: 1.5rem;">Configure exchanges shown on the /market page with direct "Trade Now" links.</p>

          <form action="/<%= adminSlug %>/update-exchanges" method="POST">
            <div id="exchangesContainer">
              <% (settings.exchanges || []).forEach((ex, index) => { %>
                <div class="dynamic-item-row" style="flex-wrap: wrap;">
                  <input type="text" name="names[]" class="form-control" value="<%= ex.name %>" placeholder="Exchange Name (e.g. Xeggex)" style="flex: 1; min-width: 140px;">
                  <input type="text" name="pairs[]" class="form-control" value="<%= ex.pair %>" placeholder="Pair (e.g. <%= coin.symbol %>/USDT)" style="flex: 1; min-width: 120px;">
                  <input type="text" name="pair_urls[]" class="form-control" value="<%= ex.pair_url %>" placeholder="Trade URL (https://...)" style="flex: 2; min-width: 200px;">
                  <input type="text" name="ticker_urls[]" class="form-control" value="<%= ex.ticker_url %>" placeholder="Optional Ticker API URL" style="flex: 2; min-width: 200px;">
                  <button type="button" class="btn-remove" onclick="this.parentElement.remove()"><i class="fa-solid fa-trash"></i></button>
                </div>
              <% }); %>
            </div>

            <button type="button" class="btn-add" onclick="addExchangeRow()"><i class="fa-solid fa-plus"></i> Add Listed Exchange</button>
            <div style="margin-top: 1.5rem;">
              <button type="submit" class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Save Listed Exchanges</button>
            </div>
          </form>
        </div>

        <script>
          function addExchangeRow() {
            const container = document.getElementById('exchangesContainer');
            const div = document.createElement('div');
            div.className = 'dynamic-item-row';
            div.style.flexWrap = 'wrap';
            div.innerHTML = `
              <input type="text" name="names[]" class="form-control" placeholder="Exchange Name (e.g. Xeggex)" style="flex: 1; min-width: 140px;">
              <input type="text" name="pairs[]" class="form-control" placeholder="Pair (e.g. <%= coin.symbol %>/USDT)" style="flex: 1; min-width: 120px;">
              <input type="text" name="pair_urls[]" class="form-control" placeholder="Trade URL (https://...)" style="flex: 2; min-width: 200px;">
              <input type="text" name="ticker_urls[]" class="form-control" placeholder="Optional Ticker API URL" style="flex: 2; min-width: 200px;">
              <button type="button" class="btn-remove" onclick="this.parentElement.remove()"><i class="fa-solid fa-trash"></i></button>
            `;
            container.appendChild(div);
          }
        </script>
      <% } %>

      <!-- TAB 7: FOOTER CONTENT & CLICKABLE LINKS -->
      <% if (tab === 'footer') { %>
        <div class="admin-card">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-bars-staggered" style="color: #6366f1;"></i> Footer Text & Clickable Links Editor
          </h2>
          <p style="color: #94a3b8; font-size: 0.85rem; margin-bottom: 1.5rem;">Customize the bottom copyright notice and add custom clickable links for your website, docs, or sponsors.</p>

          <div style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.25); border-radius: 12px; padding: 1.25rem; margin-bottom: 1.5rem;">
            <div style="font-weight: 700; color: #a5b4fc; font-size: 0.95rem; margin-bottom: 0.6rem; display: flex; align-items: center; gap: 0.5rem;">
              <i class="fa-solid fa-circle-question"></i> How to add clickable links in the footer:
            </div>
            <div style="font-size: 0.85rem; color: #cbd5e1; line-height: 1.7;">
              <strong>1. Markdown Link format (Quickest):</strong>
              <br>Wrap the link text in brackets and the URL in parentheses, for example:
              <br><code style="background: rgba(0,0,0,0.35); padding: 3px 8px; border-radius: 6px; color: #38bdf8; display: inline-block; margin: 4px 0;">[Global Ads Media](https://globaladsmedia.us)</code>
              <br>Full footer notice example:
              <br><code style="background: rgba(0,0,0,0.35); padding: 3px 8px; border-radius: 6px; color: #f1f5f9; display: inline-block; margin: 4px 0;">Global Crypto Explorer © {year}. Developed with ❤️ by [Global Ads Media](https://globaladsmedia.us) • All rights reserved.<br>• <strong>Dynamic Year:</strong> Type <code style="background: rgba(0,0,0,0.35); padding: 2px 6px; border-radius: 4px; color: #a7f3d0;">{year}</code> to automatically display the current year.</code>
              <br><br>
              <strong>2. Direct HTML Tag format:</strong>
              <br><code style="background: rgba(0,0,0,0.35); padding: 3px 8px; border-radius: 6px; color: #38bdf8; display: inline-block; margin: 4px 0;">&lt;a href="https://globaladsmedia.us" target="_blank"&gt;Global Ads Media&lt;/a&gt;</code>
              <br><br>
              <strong>3. Standalone Links:</strong>
              <br>Use the <strong>"Add Clickable Link"</strong> button below to append individual external links (e.g. Terms, Documentation, Whitepaper).
            </div>
          </div>

          <form action="/<%= adminSlug %>/update-footer" method="POST">
            <div class="form-group">
              <label>Footer Copyright Notice (supports markdown links [Title](url) and HTML)</label>
              <input type="text" name="footer_text" class="form-control" value="<%= settings.footer.text %>" placeholder="Global Crypto Explorer © 2026. Developed by [Global Ads Media](https://globaladsmedia.us)">
            </div>

            <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #94a3b8; margin-bottom: 0.6rem; margin-top: 1.5rem;">
              Custom Clickable Footer Links
            </label>
            <div id="footerLinksContainer">
              <% (settings.footer.links || []).forEach(link => { %>
                <div class="dynamic-item-row">
                  <input type="text" name="link_titles[]" class="form-control" value="<%= link.title %>" placeholder="Link Title (e.g. Privacy Policy)" style="flex: 1;">
                  <input type="text" name="link_urls[]" class="form-control" value="<%= link.url %>" placeholder="https://..." style="flex: 2;" required>
                  <button type="button" class="btn-remove" onclick="this.parentElement.remove()"><i class="fa-solid fa-trash"></i></button>
                </div>
              <% }); %>
            </div>

            <button type="button" class="btn-add" onclick="addFooterLinkRow()"><i class="fa-solid fa-plus"></i> Add Clickable Link</button>

            <div style="margin-top: 1.5rem;">
              <button type="submit" class="btn-save"><i class="fa-solid fa-floppy-disk"></i> Save Footer</button>
            </div>
          </form>
        </div>

        <script>
          function addFooterLinkRow() {
            const container = document.getElementById('footerLinksContainer');
            const div = document.createElement('div');
            div.className = 'dynamic-item-row';
            div.innerHTML = `
              <input type="text" name="link_titles[]" class="form-control" placeholder="Link Title (e.g. Whitepaper)" style="flex: 1;">
              <input type="text" name="link_urls[]" class="form-control" placeholder="https://..." style="flex: 2;" required>
              <button type="button" class="btn-remove" onclick="this.parentElement.remove()"><i class="fa-solid fa-trash"></i></button>
            `;
            container.appendChild(div);
          }
        </script>
      <% } %>

      <!-- TAB 8: ADMIN PROFILE & SECURITY -->
      <% if (tab === 'profile') { %>
        <div class="admin-card">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-user-gear" style="color: #10b981;"></i> Administrator Profile & Password
          </h2>
          <form action="/<%= adminSlug %>/update-profile" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label>Admin Name</label>
                <input type="text" name="admin_name" class="form-control" value="<%= settings.adminName %>" required>
              </div>
              <div class="form-group">
                <label>Admin Email</label>
                <input type="email" name="admin_email" class="form-control" value="<%= settings.adminEmail %>" required>
              </div>
            </div>

            <div class="form-group">
              <label>Admin Custom URL Slug (e.g. 'gamus' -> domain.com/gamus)</label>
              <div style="display: flex; align-items: center; background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 10px; padding-left: 0.9rem;">
                <span style="color: #64748b; font-size: 0.9rem;">domain.com/</span>
                <input type="text" name="admin_slug" class="form-control" value="<%= settings.adminSlug %>" style="border: none; background: transparent; padding-left: 0.2rem;" required pattern="[a-zA-Z0-9_-]+">
              </div>
            </div>

            <hr style="border-color: rgba(255, 255, 255, 0.08); margin: 1.5rem 0;">
            <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 1rem; color: #f59e0b;">
              <i class="fa-solid fa-key"></i> Change Password
            </h3>

            <div class="form-group">
              <label>Current Password (required to save changes)</label>
              <input type="password" name="current_password" class="form-control" placeholder="••••••••" required>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>New Password (leave blank if not changing)</label>
                <input type="password" name="new_password" class="form-control" placeholder="••••••••">
              </div>
              <div class="form-group">
                <label>Confirm New Password</label>
                <input type="password" name="new_password_confirm" class="form-control" placeholder="••••••••">
              </div>
            </div>

            <button type="submit" class="btn-save"><i class="fa-solid fa-shield-halved"></i> Update Profile & Security</button>
          </form>
        </div>
      <% } %>

    </main>
  </div>
</body>
</html>
