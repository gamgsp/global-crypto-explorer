  </main>

  <footer class="footer-custom">
    <div class="footer-container" style="flex-direction: column; gap: 0.85rem; width: 100%; max-width: 1350px; margin: 0 auto;">
      <% if (settings.footer.links && settings.footer.links.length > 0) { %>
        <div class="footer-links-row" style="display: flex; justify-content: center; align-items: center; gap: 1.75rem; flex-wrap: wrap; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(255, 255, 255, 0.08); width: 100%;">
          <% settings.footer.links.forEach(link => { %>
            <a href="<%= link.url %>" target="_blank" rel="noopener" style="color: var(--primary); text-decoration: none; font-size: 0.88rem; font-weight: 500; display: inline-flex; align-items: center; gap: 0.4rem; transition: all 0.2s;">
              <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 0.72rem; opacity: 0.7;"></i> <%= link.title %>
            </a>
          <% }); %>
        </div>
      <% } %>

      <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 1rem;">
        <div class="footer-copy">
          <% 
            const curYear = new Date().getFullYear();
            let rawFooter = settings.footer.text || (coin.name + ' Explorer © {year}. All rights reserved.');
            // Auto dynamic year support
            rawFooter = rawFooter.replace(/\{year\}|\{\{year\}\}/gi, curYear);
            // Convert Markdown links [Title](url) to clickable HTML links
            let formattedFooter = rawFooter.replace(/\[([^\]]+)\]\((https?:\/\/[^\s\)]+)\)/g, '<a href="$2" target="_blank" rel="noopener" style="color: var(--primary); text-decoration: underline; font-weight: 500;">$1</a>');
          %>
          <span class="footer-text-content"><%- formattedFooter %></span>
        </div>

        <div class="footer-right">
          <% if (settings.socialLinks && settings.socialLinks.length > 0) { %>
            <div class="social-links">
              <% settings.socialLinks.forEach(item => { 
                  let iconClass = 'fa-solid fa-globe';
                  const p = (item.platform || '').toLowerCase();
                  if (p.includes('twitter') || p === 'x') iconClass = 'fa-brands fa-x-twitter';
                  else if (p.includes('telegram')) iconClass = 'fa-brands fa-telegram';
                  else if (p.includes('discord')) iconClass = 'fa-brands fa-discord';
                  else if (p.includes('bitcointalk')) iconClass = 'fa-brands fa-btc';
                  else if (p.includes('forum') || p.includes('talk') || p.includes('garden')) iconClass = 'fa-solid fa-comments';
                  else if (p.includes('medium')) iconClass = 'fa-brands fa-medium';
                  else if (p.includes('substack')) iconClass = 'fa-solid fa-bookmark';
                  else if (p.includes('github')) iconClass = 'fa-brands fa-github';
                  else if (p.includes('gitlab')) iconClass = 'fa-brands fa-gitlab';
                  else if (p.includes('linkedin')) iconClass = 'fa-brands fa-linkedin';
                  else if (p.includes('reddit')) iconClass = 'fa-brands fa-reddit';
                  else if (p.includes('youtube')) iconClass = 'fa-brands fa-youtube';
                  else if (p.includes('tiktok')) iconClass = 'fa-brands fa-tiktok';
                  else if (p.includes('threads')) iconClass = 'fa-brands fa-threads';
                  else if (p.includes('whatsapp')) iconClass = 'fa-brands fa-whatsapp';
                  else if (p.includes('facebook')) iconClass = 'fa-brands fa-facebook';
                  else if (p.includes('instagram')) iconClass = 'fa-brands fa-instagram';
                  else if (p.includes('mastodon')) iconClass = 'fa-brands fa-mastodon';
                  else if (p.includes('coinmarketcap') || p.includes('cmc')) iconClass = 'fa-solid fa-coins';
                  else if (p.includes('coingecko')) iconClass = 'fa-solid fa-dragon';
                  else if (p.includes('coinpaprika')) iconClass = 'fa-solid fa-pepper-hot';
                  else if (p.includes('coincodex') || p.includes('dex') || p.includes('screener') || p.includes('watch') || p.includes('checkup')) iconClass = 'fa-solid fa-chart-line';
                  else if (p.includes('matrix') || p.includes('element')) iconClass = 'fa-solid fa-network-wired';
                  else if (p.includes('whitepaper') || p.includes('doc')) iconClass = 'fa-solid fa-file-lines';
                  else if (p.includes('mining') || p.includes('pool')) iconClass = 'fa-solid fa-server';
                  else if (p.includes('explorer')) iconClass = 'fa-solid fa-compass';
              %>
                <a href="<%= item.url %>" target="_blank" rel="noopener" class="social-link" title="<%= item.title || item.platform %>"><i class="<%= iconClass %>"></i></a>
              <% }); %>
            </div>
          <% } %>

          <div class="footer-badges">
            <span class="badge badge-success"><span class="pulse-dot"></span> <span id="footerBlockCount">Syncing blocks...</span></span>
            <span class="badge badge-cyan"><span id="footerConnCount">-- connections</span></span>
          </div>
        </div>
      </div>
    </div>
  </footer>

  <script src="/js/app.js"></script>
</body>
</html>
