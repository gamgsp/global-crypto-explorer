<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= coin.name ? coin.name + ' (' + coin.symbol + ') Explorer' : appName %> | Real-Time Blockchain Intelligence & Richlist</title>
  
  <!-- Primary SEO Meta Tags -->
  <meta name="title" content="<%= coin.name ? coin.name + ' (' + coin.symbol + ') Explorer' : appName %> | Real-Time Blockchain Intelligence">
  <meta name="description" content="Explore <%= coin.name %> (<%= coin.symbol %>) blockchain in real-time. Inspect live blocks, verified transactions, address balances, top 100 richlist, whale coin movements, and network consensus powered by Global Crypto Explorer.">
  <meta name="keywords" content="<%= coin.name %>, <%= coin.symbol %>, <%= coin.name %> explorer, blockchain explorer, crypto explorer, <%= coin.name %> richlist, block height, transaction tracker, crypto wallet balance, masternodes, bitcoin fork, Global Crypto Explorer">
  <meta name="author" content="Global Ads Media, LLC & GSP Coin Team">
  <meta name="robots" content="index, follow">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= coin.name ? coin.name + ' (' + coin.symbol + ') Explorer' : appName %>">
  <meta property="og:description" content="Real-time blockchain explorer for <%= coin.name %> (<%= coin.symbol %>). Track blocks, verified transactions, whale movements, and richlist analytics.">
  <meta property="og:image" content="<%= coin.logo || '/img/logo.svg' %>">
  <meta property="og:site_name" content="<%= coin.name ? coin.name + ' Explorer' : 'Global Crypto Explorer' %>">

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= coin.name ? coin.name + ' (' + coin.symbol + ') Explorer' : appName %>">
  <meta name="twitter:description" content="Real-time blockchain explorer for <%= coin.name %> (<%= coin.symbol %>). Track blocks, verified transactions, whale movements, and richlist analytics.">
  <meta name="twitter:image" content="<%= coin.logo || '/img/logo.svg' %>">

  <!-- JSON-LD Structured Data Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "<%= coin.name ? coin.name : 'Crypto' %> Blockchain Explorer",
    "alternateName": "Global Crypto Explorer",
    "url": "<%= settings && settings.domain ? settings.domain : '' %>",
    "description": "Real-time blockchain ledger and analytics engine for <%= coin.name %> (<%= coin.symbol %>).",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "<%= (settings && settings.domain ? settings.domain : '').replace(/\/$/, '') %>/search?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  
  <!-- Favicons -->
  <% if (coin.favicon) { %>
    <link rel="icon" href="<%= coin.favicon %>">
  <% } else { %>
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg?v=2">
    <link rel="alternate icon" href="/favicon.svg?v=2">
  <% } %>
  
  <!-- FontAwesome & Google Fonts -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=<%= encodeURIComponent(settings.theme.font || 'Outfit') %>:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  
  <!-- Chart.js CDN for client-side charts -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

  <!-- Core Styles -->
  <link rel="stylesheet" href="/css/style.css">

  <!-- Dynamic Theme Settings -->
  <style>
    :root {
      --font-sans: '<%= settings.theme.font || "Outfit" %>', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --bg-main: <%= settings.theme.bgColor || "#0b0f19" %>;
      --card-bg: <%= settings.theme.cardBg || "rgba(17, 24, 39, 0.75)" %>;
      --border-card: <%= settings.theme.cardBorder || "rgba(255, 255, 255, 0.08)" %>;
      --card-radius: <%= settings.theme.cardRadius || "14px" %>;
      --text-primary: <%= settings.theme.textPrimary || "#ffffff" %>;
      --text-muted: <%= settings.theme.textSecondary || "#9ca3af" %>;
      --primary: <%= settings.theme.accentColor || "#10b981" %>;
      --accent: <%= settings.theme.accentColor || "#10b981" %>;
    }

    body {
      font-family: var(--font-sans) !important;
      background-color: var(--bg-main) !important;
      <% if (settings.theme.bgType === 'image' && settings.theme.bgImage) { %>
      background-image: url('<%= settings.theme.bgImage %>') !important;
      background-size: cover !important;
      background-position: center !important;
      background-attachment: fixed !important;
      <% } else if (settings.theme.bgType === 'gradient') { %>
      background: radial-gradient(circle at 50% 0%, rgba(16, 185, 129, 0.12) 0%, var(--bg-main) 70%) !important;
      <% } %>
      color: var(--text-primary) !important;
    }

    .glass-card, .table-card, .stat-card, .api-endpoint-card {
      background: var(--card-bg) !important;
      border-color: var(--border-card) !important;
      border-radius: var(--card-radius) !important;
    }

    .badge-primary, .btn-primary, .chart-tab.active {
      background: var(--primary) !important;
      border-color: var(--primary) !important;
    }

    .text-primary {
      color: var(--primary) !important;
    }
  </style>
  <script>window.COIN_SYMBOL = "<%= coin.symbol || 'GSPC' %>";</script>

  <!-- ============================================== -->
  <!-- Analytics & Site-wide Tracking Tags           -->
  <!-- ============================================== -->
  <% if (settings && settings.analytics) { %>
    <!-- Google Tag (gtag.js) / Google Tag Manager (GTM) -->
    <% if (settings.analytics.googleTagEnabled && settings.analytics.googleTagId) { %>
      <% const gTagId = settings.analytics.googleTagId.trim(); %>
      <% if (gTagId.toUpperCase().startsWith('GTM-')) { %>
        <!-- Google Tag Manager -->
        <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','<%= gTagId %>');</script>
        <!-- End Google Tag Manager -->
      <% } else { %>
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=<%= gTagId %>"></script>
        <script>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '<%= gTagId %>');
        </script>
        <!-- End Google tag -->
      <% } %>
    <% } %>

    <!-- Matomo Tracking Tag -->
    <% if (settings.analytics.matomoEnabled && settings.analytics.matomoUrl && settings.analytics.matomoSiteId) { %>
      <% 
        let cleanMatomoUrl = settings.analytics.matomoUrl.trim();
        if (!cleanMatomoUrl.endsWith('/')) cleanMatomoUrl += '/';
      %>
      <!-- Matomo -->
      <script>
        var _paq = window._paq = window._paq || [];
        _paq.push(['trackPageView']);
        _paq.push(['enableLinkTracking']);
        (function() {
          var u = "<%= cleanMatomoUrl %>";
          _paq.push(['setTrackerUrl', u + 'matomo.php']);
          _paq.push(['setSiteId', '<%= settings.analytics.matomoSiteId.trim() %>']);
          var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
          g.async=true; g.src=u + 'matomo.js'; s.parentNode.insertBefore(g,s);
        })();
      </script>
      <!-- End Matomo Code -->
    <% } %>

    <!-- Custom Site-wide <head> Code / Tags (Any tag) -->
    <% if (settings.analytics.customHeadTags && settings.analytics.customHeadTags.trim()) { %>
      <%- settings.analytics.customHeadTags %>
    <% } %>
  <% } %>

</head>
<body>
  <header class="navbar-custom">
    <div class="navbar-container">
      <a href="/" class="brand-logo" title="<%= coin.name %> Explorer">
        <% if (coin.logo) { %>
          <img src="<%= coin.logo %>" alt="<%= coin.name %>" class="brand-img" height="40" style="max-height: 40px; object-fit: contain;">
        <% } else { %>
          <div style="display: flex; align-items: center; gap: 0.65rem; font-weight: 800; font-size: 1.25rem; color: #fff;">
            <div style="width: 38px; height: 38px; border-radius: 10px; background: linear-gradient(135deg, var(--primary), #3b82f6); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);">
              <i class="fa-solid fa-cube" style="color: #fff; font-size: 1.1rem;"></i>
            </div>
            <span><%= coin.name || appName %></span>
          </div>
        <% } %>
      </a>

      <button class="mobile-menu-btn" id="mobileMenuToggle" aria-label="Toggle menu">
          <i class="fa-solid fa-bars"></i>
        </button>

      <form class="search-form" action="/search" method="POST">
        <input type="text" name="search" class="search-input" placeholder="Search block height, hash, txid, or <%= coin.symbol || 'wallet' %> address..." required autocomplete="off">
        <button type="submit" class="search-btn" title="Search"><i class="fa-solid fa-magnifying-glass"></i></button>
      </form>

      <nav class="nav-menu" id="navMenu">
        <ul class="nav-links">
          <li><a href="/" class="nav-link <%= active === 'home' ? 'active' : '' %>"><i class="fa-solid fa-cubes"></i> Explorer</a></li>
          
          <% if (settings.features.hasMasternodes) { %>
            <li><a href="/masternodes" class="nav-link <%= active === 'masternodes' ? 'active' : '' %>"><i class="fa-solid fa-share-nodes"></i> <%= settings.features.masternodeLabel || 'Masternodes' %></a></li>
          <% } %>
          
          <li><a href="/richlist" class="nav-link <%= active === 'richlist' ? 'active' : '' %>"><i class="fa-solid fa-chart-pie"></i> Top 100</a></li>
          <li><a href="/market" class="nav-link <%= active === 'market' ? 'active' : '' %>"><i class="fa-solid fa-chart-line"></i> Market</a></li>
          <li><a href="/claim" class="nav-link <%= active === 'claim' ? 'active' : '' %>"><i class="fa-solid fa-certificate"></i> Claim Address</a></li>
          <li><a href="/orphans" class="nav-link <%= active === 'orphans' ? 'active' : '' %>"><i class="fa-solid fa-code-branch"></i> Orphans</a></li>
          <li><a href="/movement" class="nav-link <%= active === 'movement' ? 'active' : '' %>"><i class="fa-solid fa-money-bill-transfer"></i> Movement</a></li>
          <li><a href="/network" class="nav-link <%= active === 'network' ? 'active' : '' %>"><i class="fa-solid fa-network-wired"></i> Network</a></li>
          <li><a href="/info" class="nav-link <%= active === 'info' ? 'active' : '' %>"><i class="fa-solid fa-code"></i> API</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="main-content">
