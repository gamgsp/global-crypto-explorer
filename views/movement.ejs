<%- include('partials/header') %>

<div class="glass-card">
  <div class="glass-card-header">
    <div class="card-title">
      <i class="fa-solid fa-money-bill-transfer" style="color: var(--primary);"></i> Top 100 Coin Movements (&gt; 1M <%= coin.symbol %>)
    </div>
    <span class="badge badge-warning">High to Low</span>
  </div>

  <div class="table-responsive">
    <table class="custom-table">
      <thead>
        <tr>
          <th>Rank</th>
          <th>Transaction ID</th>
          <th>Block Height</th>
          <th>Amount Transferred</th>
          <th>Age</th>
        </tr>
      </thead>
      <tbody>
        <% if (!txs || txs.length === 0) { %>
          <tr><td colspan="5" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">Scanning blocks for coin movements...</td></tr>
        <% } else { %>
          <% txs.forEach((tx, idx) => { %>
            <tr>
              <td class="mono font-bold" style="color: <%= idx < 3 ? 'var(--primary)' : 'var(--text-muted)' %>;">
                <%= ['🥇', '🥈', '🥉'][idx] || ('#' + (idx + 1)) %>
              </td>
              <td><a href="/tx/<%= tx.txid %>" class="mono address-link"><%= tx.txid %></a></td>
              <td><a href="/block/<%= tx.blockHeight %>" class="mono">#<%= Number(tx.blockHeight).toLocaleString() %></a></td>
              <td class="mono" style="font-weight: 700; color: <%= tx.rawAmount >= 1000000 ? '#facc15' : 'var(--primary)' %>;">
                <%= tx.amount %> <%= coin.symbol %>
                <% if (tx.rawAmount >= 1000000) { %>
                  <span class="badge badge-warning" style="margin-left: 0.5rem; font-size: 0.68rem;">WHALE (&gt; 1M)</span>
                <% } %>
              </td>
              <td style="color: var(--text-muted);"><%= tx.formattedAge || (tx.age ? tx.age + "s ago" : "Just now") %></td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
